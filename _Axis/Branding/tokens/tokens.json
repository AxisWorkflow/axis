      "--axis-eyebrow": "var(--axis-navy-muted)",
      "--axis-stat-numeral": "var(--axis-paper)",
      "--axis-code-fg": "var(--axis-navy-text)",
      "--axis-code-bg": "var(--axis-navy-2)",
      "--axis-highlight": "var(--axis-navy-2)",
      "--axis-head-bg": "var(--axis-navy-2)",
      "--axis-head-fg": "var(--axis-paper)",
      "--axis-wordmark-axis": "var(--axis-paper)",
      "--axis-wordmark-workflow": "var(--axis-accent-dark)",
      "--axis-marker": "url(\"../svg/mark/mark-reversed.svg\")"
    },
    "activation": "prefers-color-scheme, or data-axis-theme=\"light|dark\" on <html>; .axis-reversed for one navy section"
  },
  "terminal": {
    "principle": "Plain text. The only colour is brand blue on headings, and only in a real terminal.",
    "realTerminal": "stdout is a TTY, TERM is set and not 'dumb', NO_COLOR is not set",
    "override": "AXIS_THEME=light|dark|plain",
    "background": "AXIS_THEME, then COLORFGBG (last field 0-6 or 8 = dark, 7 or 15 = light), else unknown",
    "heading": {
      "weight": "bold",
      "lightBackground": {
        "hex": "#2F56C9",
        "sgr24": "1;38;2;47;86;201",
        "sgr256": "1;38;5;26"
      },
      "darkBackground": {
        "hex": "#8FA8F5",
        "sgr24": "1;38;2;143;168;245",
        "sgr256": "1;38;5;111"
      },
      "unknownBackground": {
        "sgr": "1",
        "note": "bold only; neither blue is readable on both backgrounds"
      }
    },
    "reset": "0",
    "never": "escape codes in agent replies, logs, files or pipes"
  },
  "version": "2.0.1"
}