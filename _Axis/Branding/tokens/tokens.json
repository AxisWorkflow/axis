  "axel": {
    "box": "200 wide",
    "line": "5.2 units (medium); 6 to 7.5 for small sizes",
    "eyes": "solid navy, radius 12.5",
    "antenna": "empty cobalt ring, radius 12, on a 22-unit stem",
    "chest": "the Curved crosshair mark at 60 units, centred on the torso",
    "poses": [
      "stand",
      "hold",
      "wave",
      "point"
    ]
  },
  "cssVariables": {
    "--axis-ink": "#0B1220",
    "--axis-paper": "#FFFFFF",
    "--axis-surface": "#EEF2F9",
    "--axis-line": "#D5DCE8",
    "--axis-muted": "#5B6472",
    "--axis-accent": "#2F56C9",
    "--axis-accent-ink": "#FFFFFF",
    "--axis-accent-dark": "#8FA8F5",
    "--axis-accent-hover": "#2649B0",
    "--axis-accent-wash": "#F0F4FC",
    "--axis-accent-tint": "#F3F6FD",
    "--axis-navy-2": "#141D2E",
    "--axis-navy-line": "#27324A",
    "--axis-navy-text": "#DCE4F5",
    "--axis-navy-muted": "#B7C1D3",
    "--axis-bg": "var(--axis-paper)",
    "--axis-fg": "var(--axis-ink)",
    "--axis-fg-muted": "var(--axis-muted)",
