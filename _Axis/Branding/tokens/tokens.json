    "--axis-marker": "url(\"../svg/mark/mark.svg\")",
    "--axis-font-display": "\"Inter\",system-ui,-apple-system,\"Segoe UI\",sans-serif",
    "--axis-font-body": "\"Inter\",system-ui,-apple-system,\"Segoe UI\",sans-serif",
    "--axis-font-mono": "\"IBM Plex Mono\",ui-monospace,Menlo,Consolas,monospace",
    "--axis-text": "17px",
    "--axis-leading": "1.6",
    "--axis-h1": "clamp(40px,5.2vw,64px)",
    "--axis-h2": "clamp(30px,3.3vw,48px)",
    "--axis-h3": "clamp(19px,1.7vw,24px)",
    "--axis-lede": "clamp(19px,1.7vw,25px)",
    "--axis-radius-sm": "10px",
    "--axis-radius": "14px",
    "--axis-radius-lg": "22px",
    "--axis-hairline": "1px solid var(--axis-border)",
    "--axis-maxw": "1320px"
