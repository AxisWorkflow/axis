# Subprojects are parent-tracked by default. For an independent nested repository,
# add that child's exact path, for example: /Clients/Acme/
Wiki/*
!Wiki/Inbox
Wiki/Inbox/*
!Wiki/Inbox/.gitkeep
_Axis/Secrets/*
!_Axis/Secrets/.gitkeep
!_Axis/Secrets/.recipient
!_Axis/Secrets/.capsule.age
_Trash/*
!_Trash/.gitkeep
_Axis/Agents/*
!_Axis/Agents/.gitkeep
_Axis/Tracking/*
!_Axis/Tracking/.gitkeep
